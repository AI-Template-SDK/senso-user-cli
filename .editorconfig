# Editor defaults, so a contributor without the Prettier plugin installed still
# produces diffs that match the formatter rather than fighting it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in markdown; stripping them
# silently changes rendered output.
trim_trailing_whitespace = false

[Makefile]
# Make requires literal tabs for recipe lines.
indent_style = tab
